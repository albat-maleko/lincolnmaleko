// FIRESTORE SECURITY RULES for Maleko Design Agency
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ----- Checks whether the signed-in user is the one allowed admin -----
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'hNwwH6TTtHSlUmanfAQPYSBtMqd2';
    }

    // ----- Hero Slides (main homepage banner) -----
    match /slides/{slideId} {
      // Visitors can only read slides marked as active.
      allow read: if resource.data.active == true || isAdmin();
      // Only the registered administrator can change slide data.
      allow create, update, delete: if isAdmin();
    }

    // ----- Services -----
    match /services/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ----- Process Steps ("Working together") -----
    match /processSteps/{stepId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ----- Portfolio (event/showcase images) -----
    match /portfolio/{portfolioId} {
      // Visitors can only read portfolio items marked as active.
      allow read: if resource.data.active == true || isAdmin();
      // Only the registered administrator can change portfolio data.
      allow create, update, delete: if isAdmin();
    }

    // ----- Page Text (About/Services/Contact wording) -----
    match /siteContent/{contentId} {
      // This document contains public page text only.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
// end of firestore security rules
